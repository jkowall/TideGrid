{
  "openapi": "3.1.0",
  "info": {
    "title": "TideGrid API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Healthy or degraded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "version": {
                      "type": "string",
                      "description": "Deployed build identifier"
                    },
                    "environment": {
                      "type": "string",
                      "enum": [
                        "local",
                        "preview",
                        "staging",
                        "production"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error",
                        "unconfigured"
                      ]
                    },
                    "migrations": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "applied": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "latest": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "applied",
                        "latest"
                      ]
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "environment",
                    "database",
                    "migrations",
                    "time"
                  ],
                  "description": "Service health for synthetic checks; carries no tenant data"
                }
              }
            }
          },
          "500": {
            "description": "Failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "requestId"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
