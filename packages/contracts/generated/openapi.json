      "post": {
        "tags": [
          "staff"
        ],
        "summary": "Add a staff member with a role",
        "description": "Owner only. Idempotent: a retry with the same key and body replays the first response with `Idempotent-Replayed: true`.",
        "security": [
          {
            "accessJwt": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Tenant UUID; anything else answers 404"
            },
            "required": true,
            "description": "Tenant UUID; anything else answers 404",
            "name": "tenantId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{8,255}$",
              "description": "Client-generated; a UUID is recommended. Scoped by tenant, operation, and principal."
            },
            "required": true,
            "description": "Client-generated; a UUID is recommended. Scoped by tenant, operation, and principal.",
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "pattern": "^[\\x21-\\x7e]+$"
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
                    "description": "How this operator names the person"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "booking_staff",
                      "finance"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
                    "description": "Recorded in the audit history"
                  }
                },
                "required": [
                  "email",
                  "displayName",
                  "role",
                  "reason"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Member added (or the stored response replayed)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "member": {
                      "type": "object",
                      "properties": {
                        "userId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "email": {
                          "type": "string",
                          "maxLength": 254,
                          "pattern": "^[\\x21-\\x7e]+$"
                        },
                        "displayName": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "owner",
                            "booking_staff",
                            "finance"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "active",
                            "disabled"
                          ]
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "userId",
                        "email",
                        "displayName",
                        "role",
                        "status",
                        "createdAt"
                      ]
                    }
                  },
                  "required": [
                    "member"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
