                            ]
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "active",
                              "disabled"
                            ]
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "userId",
                          "email",
                          "displayName",
                          "role",
                          "status",
                          "createdAt"
                        ]
                      }
                    }
