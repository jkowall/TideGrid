{
  "name": "@tidegrid/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "migrate:status": "tsx src/migrate.ts --status",
    "neon:branch": "tsx src/neon-branch.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/migrate.integration.test.ts",
    "app-role:password": "tsx src/app-role.ts"
  },
  "dependencies": {
    "kysely": "^0.29.0",
    "kysely-postgres-js": "^5.0.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
