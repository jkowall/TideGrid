{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@tidegrid/api-worker", "dev"],
      "port": 8787
    },
    {
      "name": "console",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@tidegrid/operator-site", "dev"],
      "port": 5174
    },
    {
      "name": "guest",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GUEST_DEV_PORT=5361",
        "VITE_API_BASE=http://localhost:8961",
        "pnpm",
        "--filter",
        "@tidegrid/guest-site",
        "dev"
      ],
      "port": 5361
    },
    {
      "name": "guest-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@tidegrid/guest-site", "dev:stub"],
      "port": 5361
    }
  ]
}
