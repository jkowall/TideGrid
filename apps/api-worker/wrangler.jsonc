{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidegrid-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Public entry is api.tidegrid.us only; no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.tidegrid.us", "custom_domain": true }],
  // The app writes its own allowlisted request log. Invocation logs are off so
  // request headers (cookies, Access assertions) are never retained.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "vars": {
    "ENVIRONMENT": "preview",
    "BUILD_ID": "dev",
    "ALLOWED_ORIGINS": "https://tidegrid-guest.jkowall.workers.dev,https://console.tidegrid.us",
    // Origins allowed to send state-changing staff requests (CSRF guard).
    "STAFF_ORIGINS": "https://console.tidegrid.us",
    // Cloudflare Access application for console.tidegrid.us. The audience tag
    // and team domain are public identifiers, not secrets; G2.2 verifies the
    // Cf-Access-Jwt-Assertion header against them.
    "CF_ACCESS_TEAM_DOMAIN": "winter-feather-7169.cloudflareaccess.com",
    "CF_ACCESS_AUD": "9e89e2b88c98e68596a7433251be06f0b7013c38540aa3c1c7c6feec0c52e78f",
    // Payments on the preview (Nov 1 runbook C1, D3(a)): the fake provider,
    // with FAKE_PAYMENT_WEBHOOK_SECRET as a Wrangler secret. A production
    // configuration refuses the fake. C5 changes only the next line.
    "PAYMENT_PROVIDER": "fake",
    // Email (G2.16-live, C2): when on, EMAIL_PROVIDER and EMAIL_FROM_ADDRESS
    // are the lines right after this comment, and the send_email binding
    // follows "vars". Without them email is off and messages stay queued.
    // EMAIL_FROM_ADDRESS must equal the send_email binding's one allowed
    // sender below; change both together. nov1 refuses a release when they
    // differ (tools/release/src/phase.ts). The address is D6 in the Nov 1
    // runbook. The recipient allowlist is the EMAIL_ALLOWED_RECIPIENTS secret.
    "EMAIL_PROVIDER": "cloudflare",
    "EMAIL_FROM_ADDRESS": "bookings@mail.tidegrid.us",
    //
    // Custom hostnames (G2.14b-live, C3, deferred): when on,
    // HOSTNAME_PROVIDER and CF_SAAS_ZONE_ID are the lines right after this
    // comment. CF_SAAS_API_TOKEN is a Wrangler secret.
    //
    // Verified tenant origins on public routes (G2.14b-live, C1); "static"
    // is the rollback. This key stays last, so each config change above adds
    // its own lines without touching another's.
    "PUBLIC_CORS": "dynamic"
  },
  // Cloudflare Email Service (G2.16-live, C2). Named environments do not
  // inherit the binding. Its one allowed sender must equal EMAIL_FROM_ADDRESS.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["bookings@mail.tidegrid.us"] }],
  // DATABASE_URL is a secret (wrangler secret put DATABASE_URL) holding the
  // tidegrid_app role's direct Neon connection string. It is the fallback; the
  // code prefers the Hyperdrive binding below (query caching disabled at the
  // config, pooled connections to the direct Neon endpoint).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "0857f5560fc548319ec6a106f095db5f" }],
  "placement": { "mode": "smart" },
  // The hold sweep (G2.6): expires capacity holds past their instant and emits
  // the events. Correctness does not depend on it, so it runs every 15 minutes
  // rather than every minute, which would keep the Neon compute awake around
  // the clock. Named environments inherit it; cron triggers never fire under
  // `wrangler dev` or the Workers test runtime.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Per-IP limit on the sign-in endpoints, on top of the per-user limit in the
  // database, and a per-address, per-tenant limit on public commands such as
  // quote creation, which write rows. Namespace ids are account-unique
  // integers chosen here.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "7211",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "7212",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // The Workers test runtime cannot emulate Hyperdrive without a local Postgres,
  // and named environments do not inherit bindings, so tests run in this
  // binding-free environment and exercise the "unconfigured" health path.
  "env": {
    // Local development (`pnpm dev`): no Hyperdrive binding, so the Worker
    // connects with DATABASE_URL from the gitignored .dev.vars.
    "dev": {
      // Named environments inherit routes; an empty list keeps this one from
      // ever claiming the api.tidegrid.us custom domain.
      "routes": [],
      "vars": {
        "ENVIRONMENT": "local",
        "BUILD_ID": "dev",
        "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174",
        "STAFF_ORIGINS": "http://localhost:5174",
        // Checkout pays through the fake provider in local development (G2.7).
        // Its webhook secret, FAKE_PAYMENT_WEBHOOK_SECRET, lives in .dev.vars.
        // Deployed environments leave payments off until the owner turns them
        // on; a production configuration refuses the fake outright.
        "PAYMENT_PROVIDER": "fake",
        // Email goes to the fake provider and its local mailbox at
        // /v1/fake-email/mailbox (lane 1, the G2.16 shim); links in it point
        // at the local guest site. Only local development accepts the fake.
        "EMAIL_PROVIDER": "fake",
        "GUEST_LINK_ORIGIN": "http://{slug}.book.localhost:5173",
        // Verified tenant origins on public routes (G2.14b), so the guest
        // site works on any seeded *.book.localhost host and port.
        "PUBLIC_CORS": "dynamic"
      }
    },
    "test": {
      "routes": [],
      "vars": {
        "ENVIRONMENT": "local",
        "BUILD_ID": "test",
        "ALLOWED_ORIGINS": "https://guest.test,https://console.test",
        "STAFF_ORIGINS": "https://console.test",
        "PUBLIC_CORS": "dynamic"
      },
      // The outbox queue (W3-G2.3), local to the Workers test runtime only.
      // No deployed configuration declares a queue until it is provisioned,
      // so a release from main never needs one. The consumer retries up to
      // max_retries, then the queue hands the message to its DLQ; the code
      // records its own dead letter after five attempts (src/delivery.ts).
      "queues": {
        "producers": [{ "binding": "OUTBOX_QUEUE", "queue": "tidegrid-outbox-test" }],
        "consumers": [
          {
            "queue": "tidegrid-outbox-test",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 6,
            "dead_letter_queue": "tidegrid-outbox-test-dlq"
          },
          {
            "queue": "tidegrid-outbox-test-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 3
          }
        ]
      }
    },
    // Staging (W3-OPS-2): the resources Terraform built in
    // infra/terraform/environments/staging (apply run 43670300225). Deploy
    // with `wrangler deploy --env staging`; the script is tidegrid-api-staging.
    // Nothing is inherited but routes and crons, so every binding is named
    // here. Before the first deploy these must exist as Worker secrets on
    // tidegrid-api-staging: DATABASE_URL (the tidegrid_app role on the Neon
    // "staging" branch; the fallback to the Hyperdrive binding below),
    // FIELD_ENCRYPTION_KEYS,
    // TURNSTILE_SECRET_KEY, FAKE_PAYMENT_WEBHOOK_SECRET, and
    // EMAIL_ALLOWED_RECIPIENTS (outside production an empty list sends
    // nothing). Without the first three, staging refuses bookings and
    // signings rather than running unprotected. TURNSTILE_SITE_KEY, the
    // public key paired with TURNSTILE_SECRET_KEY, goes in "vars" below once
    // the staging widget exists; until then guests send no token and staging
    // refuses the protected public commands (human_check_required).
    "staging": {
      "routes": [{ "pattern": "api-staging.tidegrid.us", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "staging",
        "BUILD_ID": "staging",
        "ALLOWED_ORIGINS": "https://console-staging.tidegrid.us",
        "STAFF_ORIGINS": "https://console-staging.tidegrid.us",
        // The same Access application as production, with
        // console-staging.tidegrid.us added as a second hostname, so the
        // audience tag is shared.
        "CF_ACCESS_TEAM_DOMAIN": "winter-feather-7169.cloudflareaccess.com",
        "CF_ACCESS_AUD": "9e89e2b88c98e68596a7433251be06f0b7013c38540aa3c1c7c6feec0c52e78f",
        "PAYMENT_PROVIDER": "fake",
        "EMAIL_PROVIDER": "cloudflare",
        "EMAIL_FROM_ADDRESS": "bookings@mail.tidegrid.us",
        // Guest links in staging email and the console (dock code, assisted
        // signing) must never open the production guest site, whose API
        // cannot redeem a staging credential. No staging guest site exists
        // yet, so these names do not resolve: a staging link fails instead of
        // reaching production. A staging guest deployment takes this pattern.
        "GUEST_LINK_ORIGIN": "https://{slug}.book-staging.tidegrid.us",
        // Email bounces and spam complaints (W1-EMAIL-EVENTS): the queue the
        // Email Sending event subscription publishes to. The consumer also
        // needs the EMAIL_EVENTS_ACCOUNT_ID secret (tools/staging/configure.sh
        // sets it); without it every event is retried, then dead-lettered.
        "EMAIL_EVENTS_QUEUE": "tidegrid-staging-email-events",
        "PUBLIC_CORS": "dynamic"
      },
      "send_email": [
        { "name": "EMAIL", "allowed_sender_addresses": ["bookings@mail.tidegrid.us"] }
      ],
      // The tidegrid-staging config made by tools/staging/configure.sh (staging
      // run 43751150410): staging's direct host, query caching disabled.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "9c9970c1c7fd4433813445cbbfdf3ad1" }],
      "placement": { "mode": "smart" },
      // Account-unique namespace ids, apart from production's 7211 and 7212.
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "7221",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "7222",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "r2_buckets": [
        { "binding": "WAIVER_EVIDENCE", "bucket_name": "tidegrid-staging-waiver-evidence" }
      ],
      "queues": {
        "producers": [{ "binding": "OUTBOX_QUEUE", "queue": "tidegrid-staging-outbox" }],
        "consumers": [
          {
            "queue": "tidegrid-staging-outbox",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 6,
            "dead_letter_queue": "tidegrid-staging-outbox-dlq"
          },
          {
            "queue": "tidegrid-staging-outbox-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3
          },
          // The email events queue's own dead letter queue has no consumer.
          {
            "queue": "tidegrid-staging-email-events",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "dead_letter_queue": "tidegrid-staging-email-events-dlq"
          }
        ]
      }
    }
  }
}
