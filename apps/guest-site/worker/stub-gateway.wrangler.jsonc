{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Local and CI only (G2.14b): a stub GuestGateway for the guest Worker's
  // no-database browser checks. Never deployed; it has no route and no
  // workers.dev URL, and no release script names it.
  "name": "tidegrid-guest-stub-gateway",
  "main": "stub-gateway.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.svg"], "fallthrough": false }]
}
