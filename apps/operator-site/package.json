{
  "name": "@tidegrid/operator-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "wrangler types >/dev/null && tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "release": "vite build && wrangler deploy",
    "release:dry": "vite build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@tidegrid/contracts": "workspace:*",
    "@tidegrid/design-system": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.135.0"
  }
}
