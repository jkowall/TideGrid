{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidegrid-console",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "routes": [{ "pattern": "console.tidegrid.us", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
